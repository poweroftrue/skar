/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-cache, no-store, must-revalidate, private, max-age=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store

# HTML files - AGGRESSIVE no caching, always fetch fresh
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, private, max-age=0, s-maxage=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-cache, no-store, must-revalidate, private, max-age=0, s-maxage=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/
  Cache-Control: no-cache, no-store, must-revalidate, private, max-age=0, s-maxage=0
  Pragma: no-cache
  Expires: 0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# CSS and JS - No browser cache, let versioning handle caching
/*.css
  Cache-Control: no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  CDN-Cache-Control: max-age=3600

/*.js
  Cache-Control: no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  CDN-Cache-Control: max-age=3600

# Images - Can be cached since they don't change often (1 day)
/*.png
  Cache-Control: public, max-age=86400, immutable

/*.svg
  Cache-Control: public, max-age=86400, immutable

/*.jpg
  Cache-Control: public, max-age=86400, immutable

/*.jpeg
  Cache-Control: public, max-age=86400, immutable

/*.gif
  Cache-Control: public, max-age=86400, immutable

/*.webp
  Cache-Control: public, max-age=86400, immutable

